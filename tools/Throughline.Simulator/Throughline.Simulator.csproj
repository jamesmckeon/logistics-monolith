    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Throughline.Simulator.Tests"/>
        <InternalsVisibleTo Include="DynamicProxyGenAssembly2"/>
    </ItemGroup>

</Project>
