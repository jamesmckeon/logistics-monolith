headers {
  owner_id: {{ownerId}}
}

auth {
  mode: oauth2
}

auth:oauth2 {
  grant_type: client_credentials
  access_token_url: https://login.microsoftonline.com/{{tenantId}}/oauth2/v2.0/token
  refresh_token_url: 
  client_id: {{omsClientId}}
  client_secret: {{omsClientSecret}}
  scope: api://{{apiClientId}}/.default
  credentials_placement: body
  credentials_id: credentials
  token_source: access_token
  token_placement: header
  token_header_prefix: Bearer
  auto_fetch_token: true
  auto_refresh_token: false
}

vars:pre-request {
  baseUrl: http://localhost:5026
  ownerId: 1
}

docs {
  # Throughline API
  
  Three values are set once here and used by every request.
  
  | Variable | Where to change it | What it does |
  |---|---|---|
  | `baseUrl` | The selected environment (Local, QA, Prod) | Root URL of the API. Switch environments to switch targets. With no environment selected, the local URL in Collection settings, Vars tab is used. |
  | `authToken` | The selected environment, Secrets tab | Bearer token sent on every request. Paste a different token to act as a different caller. The value is kept on this machine and is never written to the collection files. |
  | `ownerId` | Collection settings, Vars tab | Sent as the `owner_id` header on every request. |
  
  ## Roles each request needs
  
  The token must hold the role for the endpoint **and** `Owner.{ownerId}` for the owner named in the header.
  
  | Requests | Role |
  |---|---|
  | Ordering | `OrderIntakeIntegrator` |
  | Inventory | `Inventory` |
  | Receiving | `Receiving` |
  | Health, OpenAPI document | none; sent without a token |
  
  ## Sample data
  
  Request bodies use owner 1 (Harrow & Finch Outfitters) and its SKUs, locations and carrier from `db/seed`. Change the SKUs when you change `ownerId`.
  
  `Create order` stores the new order's id in `orderId`, which `Get order`, `Allocate orders` and `Get allocated order` then use.
}
