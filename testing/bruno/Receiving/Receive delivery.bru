meta {
  name: Receive delivery
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/receiving/receipts
  body: json
  auth: inherit
}

body:json {
  {
    "receiptId": "{{$randomUUID}}",
    "operatorId": "7f3c2a10-5b1e-4c8a-9d2f-0a1b2c3d4e5f",
    "deliveryReference": "DEL-{{$timestamp}}",
    "billOfLading": "BOL-{{$timestamp}}",
    "carrierScac": "ODFL",
    "trailerNumber": "TRL-{{$timestamp}}",
    "containerNumber": "",
    "shipperName": "Harrow & Finch Outfitters",
    "pallets": [
      {
        "lpn": "LPN-{{$timestamp}}-01",
        "sku": "HFO-JKT-ALPINE-BLK-M",
        "quantity": 48,
        "locationId": "BULK-01"
      },
      {
        "lpn": "LPN-{{$timestamp}}-02",
        "sku": "HFO-SOCK-MERINO-GRY-L",
        "quantity": 240,
        "locationId": "BULK-02"
      }
    ]
  }
}
