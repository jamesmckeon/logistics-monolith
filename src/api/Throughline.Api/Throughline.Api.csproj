<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>bd50ca2c-c200-4482-b46b-f3456171393c</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Npgsql.OpenTelemetry"/>
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol"/>
        <PackageReference Include="OpenTelemetry.Extensions.Hosting"/>
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore"/>
        <PackageReference Include="OpenTelemetry.Instrumentation.Http"/>
        <PackageReference Include="WolverineFx.EntityFrameworkCore"/>
        <PackageReference Include="WolverineFx.Postgresql"/>
        <PackageReference Include="WolverineFx.RuntimeCompilation"/>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Throughline.Api.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\modules\ordering\Throughline.Modules.Ordering\Throughline.Modules.Ordering.csproj"/>
        <ProjectReference Include="..\..\modules\inventory\Throughline.Modules.Inventory\Throughline.Modules.Inventory.csproj"/>
        <ProjectReference Include="..\..\modules\receiving\Throughline.Modules.Receiving\Throughline.Modules.Receiving.csproj"/>
    </ItemGroup>

</Project>
