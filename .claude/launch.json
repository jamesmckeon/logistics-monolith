{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "throughline-api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/api/Throughline.Api",
        "--launch-profile",
        "http"
      ],
      "port": 5026
    },
    {
      "name": "throughline-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "src/web", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    }
  ]
}
